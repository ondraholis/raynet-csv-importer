# Copy this file to .env and fill in real values. .env is git-ignored.

# MySQL container
MYSQL_ROOT_PASSWORD=secret
MYSQL_DATABASE=raynet_crm
MYSQL_USER=raynet_app_user
MYSQL_PASSWORD=raynet_app_password

# Passed to the app container, must match the MySQL credentials above
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/raynet_crm
SPRING_DATASOURCE_USERNAME=raynet_app_user
SPRING_DATASOURCE_PASSWORD=raynet_app_password

# Raynet CRM API (see README for why the app needs a valid key to even start)
# RCRM_API_URL defaults to the production API (https://app.raynet.cz/api/v2/) if left unset — only override it
# for local testing against a mock server (see the "Local development" section in README).
RCRM_API_URL=https://app.raynet.cz/api/v2/
RCRM_API_KEY=
RCRM_API_USERNAME=
RCRM_API_INSTANCENAME=
RCRM_API_EMAIL_FROM=
RCRM_API_EMAIL_TO=

# SendGrid (or other SMTP) credentials for the completion notification email
SPRING_MAIL_USERNAME=apikey
SPRING_MAIL_PASSWORD=
